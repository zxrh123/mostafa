# 🧠 AI-Powered MikroTik Management Platform
# Environment Variables Configuration

# ==================== AI Configuration ====================
# OpenAI API (GPT-5)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4  # or gpt-5 when available
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.4

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-pro

# AI System Settings
AI_ENABLE_LEARNING=true
AI_AUTO_EXECUTE=false  # ⚠️ خطر - فقط في بيئة آمنة
AI_CONFIDENCE_THRESHOLD=0.7

# ==================== MikroTik RouterOS ====================
# Default Router Configuration
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=22
MIKROTIK_USERNAME=admin
MIKROTIK_PASSWORD=your-router-password
MIKROTIK_API_PORT=8728
MIKROTIK_CONNECTION_METHOD=ssh  # ssh, api, winbox_api

# Executor Settings
EXECUTOR_AUTO_SNAPSHOT=true
EXECUTOR_MAX_RETRIES=3
EXECUTOR_TIMEOUT=30

# ==================== Database ====================
# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mikrotik_ai_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your-db-password
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Database URL (constructed from above)
DATABASE_URL=postgresql+asyncpg://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}

# ==================== Monitoring ====================
# Network Monitor Settings
MONITOR_CHECK_INTERVAL=30  # seconds
MONITOR_HISTORY_SIZE=1000
MONITOR_ENABLE_AUTO_HEAL=true

# Alert Thresholds
ALERT_CPU_WARNING=70
ALERT_CPU_CRITICAL=85
ALERT_CPU_EMERGENCY=95

ALERT_MEMORY_WARNING=75
ALERT_MEMORY_CRITICAL=90
ALERT_MEMORY_EMERGENCY=95

ALERT_BANDWIDTH_WARNING=80
ALERT_BANDWIDTH_CRITICAL=90
ALERT_BANDWIDTH_EMERGENCY=95

# ==================== Security ====================
# JWT Settings
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API Security
API_RATE_LIMIT=100  # requests per minute
API_ENABLE_CORS=true
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==================== Server Configuration ====================
# FastAPI Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=4
SERVER_RELOAD=true  # Set to false in production
SERVER_LOG_LEVEL=info

# ==================== Redis ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# ==================== Celery ====================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=Asia/Riyadh

# ==================== Logging ====================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE_PATH=logs/mikrotik_ai.log
LOG_MAX_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=5
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ==================== Knowledge Base ====================
KB_CRAWLER_ENABLED=true
KB_CRAWLER_INTERVAL=3600  # seconds (1 hour)
KB_CRAWLER_SOURCES=https://forum.mikrotik.com,https://wiki.mikrotik.com

# ==================== Auto-Heal System ====================
AUTO_HEAL_ENABLED=true
AUTO_HEAL_MAX_ATTEMPTS=3
AUTO_HEAL_COOLDOWN=300  # seconds (5 minutes)

# ==================== Notifications ====================
# Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@mikrotik-ai.com

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Slack Notifications
SLACK_WEBHOOK_URL=your-slack-webhook-url

# ==================== Development ====================
# Development Mode
DEV_MODE=true
DEBUG=true

# ==================== Frontend ====================
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# ==================== Monitoring Services ====================
# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_ENABLED=false

# Grafana
GRAFANA_URL=http://localhost:3001
GRAFANA_ENABLED=false

# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn
SENTRY_ENABLED=false
SENTRY_ENVIRONMENT=development

# ==================== Backup ====================
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400  # seconds (24 hours)
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=backups/

# ==================== Feature Flags ====================
FEATURE_AI_CHAT=true
FEATURE_AUTO_HEAL=true
FEATURE_ADVANCED_MONITORING=true
FEATURE_KNOWLEDGE_BASE=true
FEATURE_MULTI_ROUTER=false

# ==================== Localization ====================
DEFAULT_LANGUAGE=ar  # ar, en
SUPPORTED_LANGUAGES=ar,en
TIMEZONE=Asia/Riyadh
