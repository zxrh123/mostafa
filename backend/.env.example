# Database
DATABASE_URL=postgresql://mikrotik_user:mikrotik_pass@localhost:5432/mikrotik_ai_db

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Security
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MikroTik Default Connection
MIKROTIK_DEFAULT_HOST=192.168.88.1
MIKROTIK_DEFAULT_USER=admin
MIKROTIK_DEFAULT_PASSWORD=
MIKROTIK_DEFAULT_PORT=8728
MIKROTIK_SSH_PORT=22

# Redis
REDIS_URL=redis://localhost:6379/0

# Auto-Execute (Security)
AUTO_EXECUTE_ENABLED=false
REQUIRE_AUTHENTICATION=true

# Monitoring
MONITORING_INTERVAL=30
ALERT_THRESHOLD_CPU=80
ALERT_THRESHOLD_RAM=85
ALERT_THRESHOLD_LATENCY=100

# Knowledge Base
KNOWLEDGE_BASE_ENABLED=true
KNOWLEDGE_BASE_UPDATE_INTERVAL=3600
